  "backgroundOffenders": [
    { "process": "MsMpEng",          "label": "Microsoft Defender scanning", "advice": "Add your game library to Defender exclusions and schedule scans outside gaming hours." },
    { "process": "SearchIndexer",    "label": "Windows Search indexing",     "advice": "Usually settles after a while; exclude game drives in Settings → Privacy & security → Searching Windows." },
    { "process": "OneDrive",         "label": "OneDrive sync",               "advice": "Pause syncing while gaming (OneDrive tray icon → Pause syncing)." },
    { "process": "chrome",           "label": "Google Chrome",               "advice": "Close browser tabs playing video, or disable \"Continue running background apps\" in Chrome settings." },
    { "process": "msedge",           "label": "Microsoft Edge",              "advice": "Close tabs playing video, or turn off Startup boost and background extensions in Edge settings." },
    { "process": "firefox",          "label": "Firefox",                     "advice": "Close tabs playing video while gaming." },
    { "process": "Discord",          "label": "Discord",                     "advice": "Disable Hardware Acceleration and the in-game overlay in Discord settings, or close it if you're not in a call." },
