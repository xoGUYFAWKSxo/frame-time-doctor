{
  // Frame Time Doctor knowledge base. Detection logic is in src/FrameTimeDoctor.Core/Rules;
  // wording, fixes, impact ranges and reference data live here so they can be tuned without a code change.
  // Impact ranges are PROVISIONAL until "validated" is flipped to true with real before/after captures.
  // Fix steps may use {placeholders} filled in by the rule that fired.
  "version": "2026.09.24-draft",

  "rules": [
    {
      "id": "memory-profile-off",
      "title": "Memory is running below its rated speed (EXPO/XMP off)",
      "category": "settings",
      "why": "Your RAM kit is sold to run at a tested, faster speed, but the motherboard boots it at a slow, universally safe default until you turn the memory profile on in the BIOS. On Ryzen the memory speed also sets the speed of the chip's internal fabric, so this slows down every frame where the CPU is the limit — which shows up first in the 1% lows.",
      "fix": [
        "Restart and press DEL (or F2) repeatedly to enter the BIOS.",
        "Find the memory profile setting: on Gigabyte it is \"EXPO/XMP\" on the Tweaker tab, on ASUS \"AI Overclock Tuner\", on MSI \"A-XMP/EXPO\", on ASRock \"DRAM Profile\".",
        "Select EXPO Profile 1 (rated {rated} MT/s). If the kit only lists XMP, use XMP Profile 1 — it works on AM5 in most cases.",
        "Save and exit (usually F10). The first boot after this can take 1–3 minutes while the board trains the memory; that is normal, do not power off.",
        "If the PC doesn't boot or crashes afterwards, clear CMOS or pick a lower speed. Update the BIOS first if it's older than a year — memory compatibility improves a lot with newer AGESA versions.",
        "On AM5, 6000–6400 MT/s with the memory controller clock at 1:1 (UCLK = MEMCLK) is usually the fastest configuration even if the kit is rated higher."
      ],
      "impact": { "minPct": 5, "maxPct": 15, "metric": "1% low FPS" },
      "validated": false,
      // Memory speed still moved 1% lows ~4.8% in a GPU-bound scene, above the generic 0.25x GPU-bound
      // discount (1.25-3.75%). Floor the discount at 0.5x (2.5-7.5%) until more rigs are tested.
      "minImpactScale": 0.5,
      "evidence": ["validation/2026-09-24-expo-cyberpunk-9950x.json"]
    },
    {
      "id": "cores-disabled",
      "title": "Some CPU cores or threads are switched off",
      "category": "settings",
      "why": "Your CPU has {cores} cores and {threads} threads, but Windows can only use {seen}. That usually comes from a BIOS setting (SMT, CCD control or core downcoring) or the Windows \"Number of processors\" boot option, often left over from troubleshooting or a tuning guide. Modern games spread work over many threads, and background tasks need somewhere to run without interrupting the game.",
      "fix": [
        "Read the notes above first: they say whether the limit is set in the BIOS or in Windows.",
        "BIOS: set SMT to Auto/Enabled and CCD Control / Downcore Control to Auto. Most boards have these in two places — an overclocking page (Gigabyte: Tweaker → Advanced CPU Settings) and AMD CBS (Settings → AMD CBS → CPU Common Options). A non-Auto value in either one wins, so check both.",
        "Also check for board-specific gaming modes that switch off a CCD and SMT for you (on Gigabyte, \"X3D Turbo Mode\" on BIOS versions that have it) and set them to Disabled/Auto.",
        "If changes don't stick: note your EXPO setting, use \"Load Optimized Defaults\", save and reboot, then re-enable EXPO. Make sure you aren't reloading a saved BIOS profile that has the old values.",
        "Windows (only if the notes point to Windows): press Win+R, run msconfig → Boot → Advanced options, untick \"Number of processors\", click OK and restart.",
        "If you disabled a CCD or SMT on purpose for a specific game, you can ignore this finding. Re-run the benchmark both ways to see which is faster on your system."
      ],
      "impact": { "minPct": 0, "maxPct": 10, "metric": "1% low FPS" },
      "validated": false
    },
    {
      "id": "power-plan",
      "title": "Windows power plan is holding CPU clocks down",
      "category": "settings",
      "why": "The power plan controls how eagerly Windows lets the CPU boost and how quickly idle cores wake up. A power-saving plan makes cores slow to ramp up when a game suddenly needs them, which shows up as uneven frame times rather than lower average FPS.",
      "fix": [
        "Open Start, type \"Choose a power plan\" and open it (or run: powercfg.cpl).",
        "Select \"High performance\". If it isn't listed, click \"Show additional plans\".",
        "Ryzen note: with the AMD chipset driver installed, \"Balanced\" is AMD's recommended plan and usually performs the same. Only change it if this report measured clock dips — which it did on your system.",
        "Re-run the benchmark to confirm the change helped; if not, switch back to Balanced to save power."
      ],
      "impact": { "minPct": 0, "maxPct": 6, "metric": "1% low FPS" },
      "validated": false
    },
    {
      "id": "pbo-stock",
      "title": "CPU isn't reaching its expected boost clocks",
      "category": "settings",
      "why": "Ryzen CPUs boost as high as power, current and temperature limits allow. At stock, many chips leave headroom unused. Precision Boost Overdrive (PBO) raises those limits and Curve Optimizer lowers the voltage each core needs, so the CPU can hold higher clocks in games. This only matters when the CPU is the limiting part of the frame.",
      "fix": [
        "Make sure the BIOS is recent — PBO and Curve Optimizer behaviour has improved a lot through AGESA updates.",
        "In the BIOS, find Precision Boost Overdrive (Gigabyte: Tweaker → Advanced CPU Settings; ASUS: Ai Tweaker; MSI: OC → Advanced CPU Configuration → AMD Overclocking).",
        "Set PBO to \"Enhanced\" / \"Advanced\" and set the temperature limit for your cooling: 80 °C for air coolers or 240 mm AIOs, 90 °C for 360 mm AIOs.",
        "Set Curve Optimizer to \"All Cores\", Negative, magnitude 10. Stress test (OCCT or CoreCycler for an hour). If stable, try 15–20; if you see crashes or WHEA errors, back off by 5.",
        "X3D CPUs: leave PBO limits alone if the board locks them and use Curve Optimizer only.",
        "Re-run the benchmark. If the gain is under a few percent, it isn't worth the extra heat — reset to defaults."
      ],
      "impact": { "minPct": 1, "maxPct": 6, "metric": "1% low FPS" },
      "validated": false
    },
    {
      "id": "background-processes",
      "title": "Background programs are using CPU time during gameplay",
      "category": "software",
      "why": "Anything else running competes with the game for CPU time and cache. Brief bursts from these programs (a scan, an index, a sync) are a common cause of random hitches that average FPS doesn't show.",
      "fix": [
        "Close the programs listed above before playing, or use their own \"pause while gaming\" setting.",
        "Open Task Manager → Startup apps and disable anything you don't need running all the time.",
        "For Microsoft Defender: add your game library folder as an exclusion (Windows Security → Virus & threat protection → Manage settings → Exclusions) and schedule full scans for when you're not gaming.",
        "Re-run the benchmark with them closed to see the difference."
      ],
      "impact": { "minPct": 2, "maxPct": 15, "metric": "1% low FPS" },
      "validated": false
    },
    {
      "id": "gpu-driver-outdated",
      "title": "NVIDIA graphics driver is out of date",
      "category": "drivers",
      "why": "NVIDIA ships game-specific fixes and performance work in its drivers, especially for new GPUs and recently released games. An old driver can also miss fixes for stutter and shader-compilation issues.",
      "fix": [
        "Download the latest Game Ready Driver from nvidia.com/drivers or the NVIDIA App (Drivers tab).",
        "Choose \"Custom install\" → tick \"Perform a clean installation\" if you've had driver problems before.",
        "Restart, then re-run the benchmark. The first run after a driver update may stutter while shaders recompile — run it twice and compare the second run."
      ],
      "impact": { "minPct": 0, "maxPct": 5, "metric": "1% low FPS" },
      "validated": false
    },
    {
      "id": "chipset-driver",
      "title": "AMD chipset driver is missing or out of date",
      "category": "drivers",
      "why": "The AMD chipset package installs the power-management and scheduler support that tells Windows how to use a Ryzen CPU well — which cores are fastest, and on dual-CCD X3D chips, which cores have the extra game cache.",
      "fix": [
        "Download \"AMD Chipset Drivers\" for your board's chipset (AM5 / {motherboard}) from amd.com/en/support.",
        "Run the installer and keep all components selected.",
        "Restart. On X3D CPUs with two CCDs, make sure Xbox Game Bar is up to date and Windows Game Mode is on — the V-Cache core parking relies on them.",
        "Re-run the benchmark."
      ],
      "impact": { "minPct": 0, "maxPct": 5, "metric": "1% low FPS" },
      "validated": false
    },
    {
      "id": "thermal-throttling",
      "title": "Hardware is slowing down because it's running too hot",
      "category": "cooling",
      "why": "When a CPU or GPU reaches its temperature limit it lowers its clock speed to protect itself. This is a cooling problem, not a settings problem — no software setting will fix it, and it usually gets worse the longer you play.",
      "fix": [
        "Check that all case fans spin and that dust filters and heatsinks are clean.",
        "Make sure the case has a clear intake → exhaust airflow path (front/bottom in, rear/top out) and isn't in an enclosed desk cabinet.",
        "GPU: check the fan curve in MSI Afterburner, and consider a slight undervolt — RTX cards often keep the same performance at noticeably lower temperatures.",
        "CPU: confirm the cooler is mounted firmly and the fan headers are set to a sensible curve in the BIOS. On Ryzen 7000/9000, lowering the PBO temperature limit or using Curve Optimizer reduces heat with little performance loss.",
        "Re-run the benchmark and compare the clock trace over the run."
      ],
      "impact": { "minPct": 5, "maxPct": 20, "metric": "1% low FPS" },
      "validated": false
    },
    {
      "id": "frame-cap-below-refresh",
      "title": "Frame rate is capped below what your display and GPU can do",
      "category": "display",
      "why": "Something is limiting the game to {capFps} fps even though your display refreshes at {refresh} Hz and your GPU still has spare capacity. You're getting fewer, not smoother, frames than your hardware can deliver.",
      "fix": [
        "Check the game's graphics settings for a \"Frame rate limit\" / \"Max FPS\" option and set it to Unlimited, or to {suggestedCap} if you use G-Sync/FreeSync.",
        "Check NVIDIA Control Panel → Manage 3D settings → Max Frame Rate (global and the game's program profile).",
        "Close other limiters: RivaTuner Statistics Server (RTSS), the NVIDIA App overlay's frame limiter, or Radeon Chill if a second GPU is present.",
        "If you capped it on purpose (for power, noise or consistency), you can ignore this finding.",
        "Use only one frame limiter at a time — stacking two causes uneven frame pacing."
      ],
      "impact": { "minPct": 10, "maxPct": 40, "metric": "average FPS" },
      "validated": false
    },
    {
      "id": "vsync-judder",
      "title": "V-Sync is causing half-rate hitches",
      "category": "display",
      "why": "With classic V-Sync on, a frame that misses a screen refresh by even a fraction of a millisecond is held until the next one, so it stays on screen for twice as long ({doublePeriod} ms instead of {period} ms). Those doubled frames are the judder you feel when FPS dips just below your refresh rate.",
      "fix": [
        "If your monitor supports G-Sync / G-Sync Compatible (most gaming monitors do): enable it in NVIDIA Control Panel → Set up G-SYNC.",
        "Turn V-Sync OFF in the game, and ON in NVIDIA Control Panel → Manage 3D settings (the recommended G-Sync setup).",
        "Cap the frame rate to {suggestedCap} fps (a few below refresh) using NVIDIA Reflex if the game has it, otherwise NVIDIA Control Panel → Max Frame Rate.",
        "Without a VRR monitor: lower settings until the game holds {refresh} fps steadily, or accept tearing with V-Sync off."
      ],
      "impact": { "minPct": 10, "maxPct": 40, "metric": "1% low FPS" },
      "validated": false
    },
    {
      "id": "composed-presentation",
      "title": "Game is being composited by Windows instead of flipping directly",
      "category": "display",
      "why": "The game's frames are going through the Windows desktop compositor ({presentMode}) instead of being shown directly. That adds up to a frame of latency, can disable G-Sync/FreeSync, and makes frame pacing less even. It usually happens in windowed/borderless mode when something is drawn on top of the game.",
      "fix": [
        "Switch the game to exclusive Fullscreen if it offers it, or keep Borderless and enable Windows Settings → Display → Graphics → \"Optimizations for windowed games\".",
        "Close or disable overlays that draw over the game (Discord, Steam, GeForce/NVIDIA App overlay, RGB/monitoring tools, screen recorders).",
        "Make sure Windows display scaling isn't forcing the game to render at a different resolution than your desktop.",
        "Re-run the benchmark and check that the presentation mode now reads \"Hardware: Independent Flip\" or \"Hardware Composed: Independent Flip\"."
      ],
      "impact": { "minPct": 0, "maxPct": 5, "metric": "1% low FPS" },
      "validated": false
    }
  ],

